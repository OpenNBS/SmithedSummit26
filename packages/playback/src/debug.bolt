from src.utilities.sphere import sphere
import logging
from src.config import SONGS_PATH

from ./const import REGIONS, SPEAKER_RANGES


DELAY_TICKS = 80


logger = logging.getLogger(__name__)

logger.info("Generating debug functions")

#> setup

append function ~/tick:
    function ~/../show_debug_particles
    execute if score debug nbs matches 1 run schedule function (~/) f'{DELAY_TICKS}t' replace

append function ~/toggle:
    scoreboard players add debug nbs 1
    execute if score debug nbs matches 2.. run scoreboard players set debug nbs 0

    execute if score debug nbs matches 1 run function ~/../tick


#> display

for data in ctx.meta["speaker_ranges"]:
    speaker_type = data["name"]
    radius = data["outer_range"]
    inner_radius = data["inner_range"]

    append function ~/show_debug_particles:
        execute as @e[type=item_display,tag=f"nbs.speaker.{speaker_type}"] at @s run function ~/../spawn_particles/{speaker_type}

    function ~/spawn_particles/{speaker_type}:
        for pos in range(-radius, radius + 1):
            if pos % 2 == 0:
                particle minecraft:block_marker{block_state:{Name:"minecraft:red_concrete"}} f"~{pos}" ~ ~ 0 0 0 0 1 force
                particle minecraft:block_marker{block_state:{Name:"minecraft:green_concrete"}} ~ f"~{pos}" ~ 0 0 0 0 1 force
                particle minecraft:block_marker{block_state:{Name:"minecraft:blue_concrete"}} ~ ~ f"~{pos}" 0 0 0 0 1 force

        for point in sphere(radius=radius, density=0.03):
            x = point[0]
            y = point[1]
            z = point[2]

            particle minecraft:block_marker{block_state:{Name:"minecraft:purple_stained_glass"}} f"~{x}" f"~{y}" f"~{z}" 0 0 0 0 1 force

        for point in sphere(radius=inner_radius, density=0.03):
            x = point[0]
            y = point[1]
            z = point[2]

            particle minecraft:block_marker{block_state:{Name:"minecraft:cyan_stained_glass"}} f"~{x}" f"~{y}" f"~{z}" 0 0 0 0 1 force


#> place speakers

function ~/place_speakers:
    # Keep a one-block gap between the largest speaker ranges. This gives us
    # a simple grid that works for every speaker type without overlapping.
    grid_cell_size = 0
    for speaker_type in SPEAKER_RANGES:
        diameter = speaker_type["outer_range"] * 2 + 1
        if diameter > grid_cell_size:
            grid_cell_size = diameter

    col = -1
    for region in REGIONS:
        row = -1
        col += 1
        for speaker in SPEAKER_RANGES:
            row += 1
            speaker_type = speaker["name"]
            x = col * grid_cell_size + grid_cell_size / 2
            z = row * grid_cell_size + grid_cell_size / 2
            coords = f"~{x} ~ ~{z}"
            execute positioned coords run function f"nbs:speaker/place/{region}/{speaker_type}"
            execute positioned coords run setblock ~ ~-1 ~ minecraft:stone keep
        