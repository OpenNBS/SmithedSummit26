from pathlib import Path
from beet.core.utils import normalize_string
from beet import Sound, SoundConfig
import json
import pynbs
import logging

from src.utilities.note_block import get_notes
from src.config import SONGS_PATH

SPEAKER_RANGES = ctx.meta["speaker_ranges"]
REGIONS = ctx.meta["regions"]
ANIM_COUNT = ctx.meta["anim_count"]

logging.info("Generating songs")

append function ~/../playback/load:
    data modify storage nbs:playback songs set value {}
    for region in REGIONS:
        data modify storage nbs:playback f"songs.{region}" set value []

current_index_per_region = {}
for region in REGIONS:
    current_index_per_region[region] = 0

for song_data in ctx.meta["song_manifest"]:
    song_id = song_data["id"]
    title = song_data["title"]
    author = song_data["author"]
    region = song_data["region"]

    logging.info("Processing: %s", song_id)

    if region is None:
        logging.warn(f"Song {song_id} has no region assigned; skipping")
        continue

    song_index = current_index_per_region[region]
    current_index_per_region[region] += 1

    if region is None:
        continue

    formatted_string = f"{title} - {author}"

    path = SONGS_PATH / f"{song_id}.nbs"

    if not path.exists():
        logging.warn(f"Song file not found: {path}")
        continue

    song = pynbs.read(path)

    append function ~/../playback/load:
        data modify storage nbs:playback f"songs.{region}" append value {
            "name": song_id,
            "index": song_index,
            "formatted_string": formatted_string,
            "title": title,
            "author": author,
        }

    for chord in get_notes(song):
        tick = chord[0]
        notes = chord[1]
        function f"nbs:song/{song_id}/{tick}/root":
            # iterate through this region's speakers; each entry carries its own speaker_type
            data modify storage nbs:temp input set value {}
            data modify storage nbs:temp input.song set value (song_id)
            data modify storage nbs:temp input.tick set value (tick)
            store result score f"{region}.#len" nbs if data storage nbs:playback f"locations.{region}[]"
            store result storage nbs:temp input.i int 1 scoreboard players set f"{region}.#iter" nbs 0
            function f"nbs:playback/{region}/speaker_iter/root" with storage nbs:temp input

            scoreboard players add notes_played nbs_stats f"{len(notes)}"
            scoreboard players add ticks_played nbs_stats 1

            for note in notes:
                for speaker in SPEAKER_RANGES:
                    speaker_type = speaker["name"]
                    outer_range = speaker["range"]
                    inner_range = speaker["inner_range"]

                    if note.instrument == "BEAT":
                            append function ~/../{speaker_type}:
                                store result score #random nbs random value (1, ANIM_COUNT)
                                for i in range(ANIM_COUNT):
                                    execute
                                        if score #random nbs matches (i+1)
                                        if entity @a[distance=(0, outer_range)]
                                        function f"summit_ambiance:speaker_{region}/animations/beat_{(i+1)}/play"
                                execute if entity @a[distance=(0, outer_range)] run particle minecraft:note ~ ~1.25 ~ 0 0 0 1 1
                        continue
                
                    # TODO: dynamically inject the correct function name based on the speaker type
                    append function ~/../{speaker_type}:
                        playsound f"{note.play(inner_range, outer_range)}"

                ctx.meta["instruments"].add(note.instrument)


    function f"nbs:song/{song_id}/{tick + 40}/root":
        function f"nbs:playback/{region}/advance"


logging.info("🎉 Song processing complete!")
