from pathlib import Path
from beet.core.utils import normalize_string
from beet import Sound, SoundConfig
import json
import pynbs
import logging

from src.utilities.note_block import get_notes
import src.config as config

logging.info("Generating songs")

append function ~/../playback/load:
    data modify storage nbs:playback songs set value []

for song_stuff in enumerate(config.SONG_MANIFEST):
    song_index = song_stuff[0]
    song_data = song_stuff[1]

    song_id = song_data["id"]
    title = song_data["title"]
    author = song_data["author"]
    region = song_data["region"]

    if region is None:
        continue

    formatted_string = f"{title} - {author}"

    path = config.SONGS_PATH / f"{song_id}.nbs"

    if not path.exists():
        print(f"Song file not found: {path}")
        continue

    song = pynbs.read(path)

    print("Processing:", song_id)

    append function ~/../playback/load:
        data modify storage nbs:playback songs append value {
            "name": title,
            "index": song_index,
            "formatted_string": formatted_string,
            "title": title,
            "author": author,
        }

    for chord in get_notes(song):
        tick = chord[0]
        notes = chord[1]
            #data modify storage nbs:playback playing set from storage nbs:playback songs[0]
        function f"nbs:song/{song_id}/{tick}/root":
            # iterate through speaker UUIDs
            data modify storage nbs:temp input set value {}
            data modify storage nbs:temp input.song set value (song_id)
            data modify storage nbs:temp input.tick set value (tick)
            for speaker in config.SPEAKER_RANGES:
                speaker_type = speaker["name"]
                speaker_range = speaker["range"]
                store result score #len nbs if data storage nbs:playback f"locations.{speaker_type}[]"
                store result storage nbs:temp input.i int 1 scoreboard players set #iter nbs 0
                data modify storage nbs:temp input.speaker_type set value (speaker_type)

                function nbs:playback/speaker_iter with storage nbs:temp input

            scoreboard players add notes_played nbs_stats f"{len(notes)}"
            scoreboard players add ticks_played nbs_stats 1

            for note in notes:
                for speaker in config.SPEAKER_RANGES:
                    speaker_type = speaker["name"]
                    speaker_range = speaker["range"]

                    if note.instrument == "BEAT":
                            append function ~/../{speaker_type}:
                                store result score #random nbs random value (1, config.ANIM_COUNT)
                                for i in range(config.ANIM_COUNT):
                                    execute
                                        if score #random nbs matches (i+1)
                                        if entity @a[distance=(0, speaker_range)]
                                        function f"animated_java:speaker_{region}/animations/beat_{(i+1)}/play"
                        continue
                
                    append function ~/../{speaker_type}:
                        playsound f"{note.play_short_range()}"

                config.INSTRUMENTS.add(note.instrument)



    function f"nbs:song/{song_id}/{tick + 40}/root":
        function f"nbs:playback/{region}/advance"

    break


print("🎉 LGTM")
