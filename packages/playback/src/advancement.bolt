from ./const import REGIONS, SONG_MANIFEST

REGION_ICONS = {
    plateaus: "summit_icons:patched_plateaus",
    tropics: "summit_icons:textured_tropics",
    woodlands: "summit_icons:welded_woodlands",
}

REGION_NAMES = {
    plateaus: "Patched Plateaus",
    tropics: "Textured Tropics",
    woodlands: "Welded Woodlands",
}

DISCS = [
    "minecraft:music_disc_13",
    "minecraft:music_disc_5",
    "minecraft:music_disc_blocks",
    "minecraft:music_disc_bounce",
    "minecraft:music_disc_chirp",
    "minecraft:music_disc_creator",
    "minecraft:music_disc_creator_music_box",
    "minecraft:music_disc_far",
    "minecraft:music_disc_lava_chicken",
    "minecraft:music_disc_mall",
    "minecraft:music_disc_mellohi",
    "minecraft:music_disc_otherside",
    "minecraft:music_disc_pigstep",
    "minecraft:music_disc_precipice",
    "minecraft:music_disc_relic",
    "minecraft:music_disc_stal",
    "minecraft:music_disc_strad",
    "minecraft:music_disc_tears",
    "minecraft:music_disc_wait",
    "minecraft:music_disc_ward",
]

HEAR_ALL_SONGS = "nbs:playback/hear_all_songs"
HEARD_ALL_SONGS_STICKER = "nbs:stickers/heard_all_songs"


def split_parentheses(title: str) -> tuple[str, str]:
    # Split the title into the part before the first parentheses,
    # and the part between the first and last parentheses (inclusive)
    start = title.find("(")
    end = title.rfind(")")
    if start != -1 and end != -1 and end > start:
        return (title[:start].strip(), title[start : end + 1].strip())
    return (title.strip(), "")


def get_description(title: str, author: str) -> str:
    _, between = split_parentheses(title)
    if between:
        return f"{between}\nby {author}"
    else:
        return f"by {author}"


advancement f"nbs:playback/root" {
    "display": {
        "icon": {
            "id": "minecraft:jukebox"
        },
        "title": "Note Block Studio Songs",
        "description": "All of the songs at Smithed Summit!",
        "background": "minecraft:block/note_block",
        "show_toast": false,
        "announce_to_chat": false
    },
    "criteria": {
        "song": {
            "trigger": "minecraft:impossible"
        }
    }
}

LAST_SONG_PARENT = {}
for region in REGIONS:
    advancement f"nbs:playback/{region}" {
        "display": {
            "icon": {
                "id": "minecraft:poisonous_potato",
                "components": {
                    "minecraft:item_model": REGION_ICONS[region]
                }
            },
            "title": f"{REGION_NAMES[region]} Songs",
            "description": "",
            "show_toast": true,
            "announce_to_chat": false
        },
        "parent": f"nbs:playback/root",
        "criteria": {
            "region": {
                "trigger": "minecraft:impossible"
            }
        }
    }

    LAST_SONG_PARENT[region] = f"nbs:playback/{region}"


def generate_song_advancement(region: str, song_id: str, song: str, author: str):
    global LAST_SONG_PARENT
    adv_path = f"nbs:song/{song_id}"
    progress_function = f"nbs:playback/hear_all_songs/{song_id}"

    advancement adv_path {
        "display": {
            "icon": {
                # Deterministic random item from DISCS
                "id": DISCS[hash(song_id) % len(DISCS)]
            },
            "title": split_parentheses(song)[0],
            "description": get_description(song, author),
            "show_toast": false,
            "announce_to_chat": false
        },
        "parent": LAST_SONG_PARENT[region],
        "criteria": {
            "song": {
                "trigger": "minecraft:impossible"
            }
        },
        # Progress the collector once when this song is first heard.
        "rewards": {
            "function": progress_function
        }
    }
    LAST_SONG_PARENT[region] = adv_path

    function progress_function:
        raw f"advancement grant @s only {HEAR_ALL_SONGS} {song_id}"


@defer
def end_cap():
    for region in REGIONS:
        advancement f"nbs:playback/{region}/end" {
            "display": {
                "icon": {
                    "id": "minecraft:poisonous_potato",
                    "components": {
                        "minecraft:item_model": REGION_ICONS[region]
                    }
                },
                "title": f"{REGION_NAMES[region]} Songs",
                "description": "",
                "show_toast": false,
                "announce_to_chat": false
            },
            "parent": LAST_SONG_PARENT[region],
            "criteria": {
                "region": {
                    "trigger": "minecraft:impossible"
                }
            }
        }

    # Adventuring Time-style collector: one criterion per nbs:song/* advancement.
    # Hidden/technical — sticker UI lives in the event sticker book.
    song_criteria = {}
    for song in SONG_MANIFEST:
        if song.get("region") is None:
            continue
        song_criteria[song["id"]] = {"trigger": "minecraft:impossible"}

    advancement HEAR_ALL_SONGS {
        "criteria": song_criteria,
        "rewards": {
            "function": HEARD_ALL_SONGS_STICKER
        }
    }

function ~/base:
    merge function_tag summit:api/on_join {"values": [(~/)]}

    advancement grant @s only nbs:playback/root

    for region in REGIONS:
        advancement grant @s only f"nbs:playback/{region}"
        advancement grant @s only f"nbs:playback/{region}/end"
