# Storage Containers
TEMP = {}
PLAYBACK = {}

SPEAKER_RANGES = ctx.meta["speaker_ranges"]
REGIONS = ctx.meta["regions"]
REGION_COUNTS = ctx.meta["region_counts"]
SONG_MANIFEST = ctx.meta["song_manifest"]
SONG_INDICES = {}

for region in REGIONS:
    TEMP[region] = f"nbs:temp/{region}"
    PLAYBACK[region] = f"nbs:playback/{region}"
