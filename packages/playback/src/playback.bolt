import logging

from src.config import SPEAKER_RANGES

from ./const import INCLUDE_ADVANCEMENTS, REGIONS, PLAYBACK, TEMP, SONG_STORAGE


logger = logging.getLogger(__name__)

logger.info("Generating playback functions")


#> setup

append function ~/load:
    merge function_tag minecraft:load {"values": [(~/)]}

    scoreboard objectives add nbs dummy
    scoreboard players set shuffle nbs 0

    for region in REGIONS:
        # just in case
        execute unless data storage TEMP[region] input run data modify storage TEMP[region] input set value {}

        # Keep a valid current-song index across reloads and manifest changes.
        execute unless score f"{region}.songindex" nbs matches -2147483648..2147483647 run scoreboard players set f"{region}.songindex" nbs 0
        if score f"{region}.songindex" nbs matches f"{REGIONS[region].song_count}.." run scoreboard players set f"{region}.songindex" nbs 0
        if score f"{region}.songindex" nbs matches ..-1 run scoreboard players set f"{region}.songindex" nbs 0
        
        # load current song into storage if it's the first time loading the region
        function ~/../{region}/change_song

    function #nbs:playback/play


append function ~/tick:
    merge function_tag minecraft:tick {"values": [(~/)]}
    
    # handles tick TBD: threading
    for region in REGIONS:
        if score f"{region}.playing" nbs matches 1.. function ~/../{region}/tick


for region in REGIONS:
    #> Main regional namespace
    function ~/{region}:

        #> Region tick
        function ~/tick:
            # grab playback info
            if score f"{region}.playing" nbs matches 1 run scoreboard players add f"{region}.songtime" nbs 1
            store result storage PLAYBACK[region] playing.tick int 1 run scoreboard players get f"{region}.songtime" nbs
            
            # these should cache nicely as it's only 6 states during a songs runtime
            store result storage PLAYBACK[region] playing.random int 1 run random value 1..6

            for speaker_range in SPEAKER_RANGES:
                execute function ~/{speaker_range.name}:
                    # Ticks are consistent per speaker range
                    data remove storage TEMP[region] payload
                    with storage PLAYBACK[region] playing:
                        raw f"$data modify storage {TEMP[region]} payload \
                            set from storage {SONG_STORAGE[region]} songs.$(name).ticks.t$(tick).{speaker_range.name}"
                    
                    # empty tick
                    execute unless data storage TEMP[region] payload.count run return fail

                    # advance
                    execute if data storage TEMP[region] payload{advance:1b} run function ~/../../advance

                    execute
                        as @e[type=item_display,tag=f"nbs.speaker.{region}",tag=f"nbs.speaker.{speaker_range.name}"]
                        at @s
                        if entity @a[distance=(0, speaker_range.outer_range), limit=1]
                        run function ~/speaker with storage PLAYBACK[region] playing:
                            # run the beat, also this macro cache should be consistent
                            raw f"$execute \
                                if data storage {TEMP[region]} payload{{beat:1b}} \
                                run function summit_ambiance:speaker_{region}/animations/beat_$(random)/play"

                            if INCLUDE_ADVANCEMENTS:
                                raw f"$advancement grant @a[distance=..{speaker_range.outer_range}] only nbs:song/$(name)"

                            with storage TEMP[region] payload:
                                raw f"$function nbs:songs/template/$(count) with storage {TEMP[region]} payload"

        # Song selection is a two-step hash lookup. The first macro turns the
        # scoreboard index into a string-keyed song id (`i0`, `i1`, ...). The
        # second uses that id to copy only the small metadata compound into
        # PLAYBACK. Song tick data is never copied on song changes.
        function ~/change_song:
            scoreboard players set f"{region}.songtime" nbs -1
            data remove storage PLAYBACK[region] playing
            data modify storage TEMP[region] input set value {}
            store result storage TEMP[region] input.index int 1 run scoreboard players get f"{region}.songindex" nbs
            function ~/../select_song with storage TEMP[region] input

        function ~/select_song:
            raw f"$data modify storage {TEMP[region]} input.name set from storage {SONG_STORAGE[region]} index.i$(index)"
            execute unless data storage TEMP[region] input.name run return fail
            return run function ~/metadata with storage TEMP[region] input

            function ~/metadata:
                raw f"$data modify storage {PLAYBACK[region]} playing set from storage {SONG_STORAGE[region]} songs.$(name).metadata"
                execute unless data storage PLAYBACK[region] playing.name run return fail
                function ~/../../title with storage PLAYBACK[region] playing
                return 1


        #> Effects
        # display AJ text
        function ~/title:
            raw f'$execute \
                as @e[type=item_display,tag=nbs.speaker.{region}] \
                on passengers \
                if entity @s[tag=aj.global.node.text_display] \
                run data modify entity @s text.text set value "🎵 $(formatted_string)"'

            # display actionbar to nearby players (a bit laggy but very rare)
            for speaker in SPEAKER_RANGES:
                variant = speaker["name"]
                range = speaker["outer_range"]
                title_color = REGIONS[region].title_color

                raw f'$execute \
                    at @e[type=item_display,tag=nbs.speaker.{region},tag=nbs.speaker.{variant}] \
                    run title @a[distance=..{range}] actionbar [{{"text":"🎵 Now Playing: ","color":"{title_color}"}},{{"text":"$(formatted_string)","color":"white"}}]'


        #> Song Controls

        song_count = REGIONS[region].song_count

        # we use function tags for easy search
        function ~/next:
            merge function_tag (~/) {"values": [(~/)]}
            scoreboard players add f"{region}.songindex" nbs 1
            if score f"{region}.songindex" nbs matches f"{song_count}.." run scoreboard players set f"{region}.songindex" nbs 0
            function ~/../change_song

        function ~/prev:
            merge function_tag (~/) {"values": [(~/)]}
            scoreboard players remove f"{region}.songindex" nbs 1
            if score f"{region}.songindex" nbs matches ..-1 run scoreboard players set f"{region}.songindex" nbs (song_count - 1)
            function ~/../change_song

        function ~/pause:
            merge function_tag (~/../../pause) {"values": [(~/)]}
            scoreboard players set f"{region}.playing" nbs 0

        function ~/play:
            merge function_tag (~/../../play) {"values": [(~/)]}
            scoreboard players set f"{region}.playing" nbs 1

        function ~/stop:
            merge function_tag (~/../../stop) {"values": [(~/)]}
            scoreboard players set f"{region}.playing" nbs 0
            scoreboard players set f"{region}.songtime" nbs -1

        function ~/shuffle:
            merge function_tag (~/) {"values": [(~/)]}

            scoreboard players operation f"{region}.prevsong" nbs = sf"{region}.songindex" nbs
            store result score f"{region}.songindex" nbs run random value (0, song_count - 1)
            if score f"{region}.songindex" nbs = f"{region}.prevsong" nbs run function ~/../next
            function ~/../change_song

        function ~/advance:
            merge function_tag (~/) {"values": [(~/)]}
            if score shuffle nbs matches 0 run function ~/../next
            if score shuffle nbs matches 1 run function ~/../shuffle
