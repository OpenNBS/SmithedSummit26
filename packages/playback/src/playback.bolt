import glob
import logging

logging.info("Generating playback functions")

#> setup
merge function_tag minecraft:load {
    "values": [(~/load)]
}

append function ~/load:
    scoreboard objectives add nbs dummy
    scoreboard objectives add nbs_stats dummy
    scoreboard players set shuffle nbs 1
    function ~/play

    schedule function ~/../tick 1t replace
    
    execute function ~/save_speaker_positions:
        data modify storage nbs:playback locations set value {speaker: [], loudspeaker: []}
        data modify storage nbs:temp input set value {}
        for entity in ["speaker", "loudspeaker"]:
            as @e[type=item_display, tag=f"nbs_{entity}"]:
                data modify storage nbs:temp input.UUID set from entity @s UUID
                function animated_java:global/internal/gu/convert_uuid_array_to_string with storage nbs:temp input
                data modify storage nbs:playback f"locations.{entity}" append from storage aj:uuid main.out

# Helper function that iterates through all speaker and loudspeaker in the world
# Takes {speaker_type: "speaker", i: 0, song: "song", tick: 0}
function ~/speaker_iter:
    $data modify storage nbs:temp input.uuid set from storage nbs:playback locations.$(speaker_type)[$(i)]
    execute function ~/uuid with storage nbs:temp input:
        $execute as $(uuid) at @s run function nbs:song/$(song)/$(tick)/$(speaker_type)
    store result storage nbs:temp input.i int 1 scoreboard players add #iter nbs 1
    if score #iter nbs < #len nbs function (~/) with storage nbs:temp input


for region in ctx.meta["regions"]:

    function ~/{region}/tick:
        schedule function (~/) 1t replace
        execute if score f"{region}_playing" nbs matches 1 run scoreboard players add f"{region}_songtime" nbs 1
        execute store result storage nbs:playback f"playing.{region}.tick" int 1 run scoreboard players get f"{region}_songtime" nbs
        function nbs:playback with storage nbs:playback f"playing.{region}" # TODO: this command works in a command block, but not here :c

    function ~/{region}/playback:
        $function nbs:song/$(name)/$(tick)/root

    function ~/{region}/change_song:
        scoreboard players add songs_played nbs_stats 1
        scoreboard players set f"{region}.songtime" nbs -1
        execute store result storage nbs:playback f"playing.{region}.index" int 1 run scoreboard players get f"{region}.songindex" nbs
        function ~/{region}/zzz_change_song with storage nbs:playback f"playing.{region}"   

    function ~/{region}/zzz_change_song:
        $data modify storage nbs:playback f"playing.{region}" set from storage nbs:playback f"songs.{region}[$(index)]"
        function ~/{region}/title with storage nbs:playback f"playing.{region}"


    #> Effects

    function ~/{region}/title:
        $execute at @e[type=item_display,tag=nbs_speaker] run title @a[distance=..12] actionbar {"text":"","extra":[{"text":"🎵 Now Playing: ","color":"green"},{"text":"$(formatted_string)","color":"white"}]}
        $execute at @e[type=item_display,tag=nbs_loudspeaker] run title @a[distance=..48] actionbar {"text":"","extra":[{"text":"🎵 Now Playing: ","color":"green"},{"text":"$(formatted_string)","color":"white"}]}
        $execute as @e[tag=aj.music_speaker.root] on passengers if entity @s[tag=aj.music_speaker.bone.text_display] run data modify entity @s text set value '{"text":"🎵 $(formatted_string)","color":"green"}'
        $execute as @e[type=item_display,tag=aj.music_speaker.root] on passengers if entity @s[tag=aj.music_speaker.bone.text_display] run data modify entity @s text set value {"text":"","extra":[{"text":"🎵 Now Playing: ","color":"green"},{"text":"$(formatted_string)","color":"white"}]}
        $title @a[tag=nbs_headphones] actionbar {"text":"","extra":[{"text":"🎧 Now Playing: ","color":"green"},{"text":"$(formatted_string)","color":"white"}]}


    #> Spawn Speakers

    function ~/{region}/place_speaker:
        # function animated_java:music_speaker/summon/default
        execute positioned as @s rotated as @s run summon minecraft:item_display ~ ~ ~ {item:{count:1b,id:"minecraft:note_block"},Tags:["nbs.speaker_new"]}
        tag @n[type=item_display,distance=..1,tag=nbs_speaker_new] add nbs.speaker
        tag @n[type=item_display,distance=..1,tag=nbs_speaker_new] remove nbs.speaker_new

    function ~/{region}/place_loudspeaker:
        # function animated_java:music_speaker/summon/default
        execute positioned as @s rotated as @s run summon minecraft:item_display ~ ~ ~ {item:{count:1b,id:"minecraft:note_block"},Tags:["nbs.speaker_new"]}
        tag @n[type=item_display,distance=..1,tag=nbs_speaker_new] add nbs.loudspeaker
        tag @n[type=item_display,distance=..1,tag=nbs_speaker_new] remove nbs.speaker_new

    #> Song Controls

    song_count = ctx.meta["region_counts"][region] + 1

    function ~/{region}/next:
        scoreboard players add f"{region}.songindex" nbs 1
        execute if score f"{region}.songindex" nbs matches f"{song_count}.." run scoreboard players set f"{region}.songindex" nbs 0
        function ~/../change_song

    function ~/{region}/prev:
        scoreboard players remove f"{region}.songindex" nbs 1
        execute if score f"{region}.songindex" nbs matches ..-1 run scoreboard players set f"{region}.songindex" nbs (song_count - 1)
        function ~/../change_song

    function ~/{region}/pause:
        scoreboard players set f"{region}.playing" nbs 0

    function ~/{region}/play:
        scoreboard players set f"{region}.playing" nbs 1

    function ~/{region}/stop:
        scoreboard players set f"{region}.playing" nbs 0
        scoreboard players set f"{region}.songtime" nbs -1

    function ~/{region}/shuffle:
        scoreboard players operation f"{region}.prevsong" nbs = songindex nbs
        execute store result score f"{region}.songindex" nbs run random value (0, song_count - 1)
        execute if score f"{region}.songindex" nbs = f"{region}.prevsong" nbs run function ~/{region}/next
        function ~/{region}/change_song

    function ~/{region}/advance:
        execute if score shuffle nbs matches 0 run function ~/{region}/next
        execute if score shuffle nbs matches 1 run function ~/{region}/shuffle


    #> Global Controls

    append function ~/pause:
        scoreboard players set f"{region}.playing" nbs 0

    append function ~/play:
        scoreboard players set f"{region}.playing" nbs 1
    append function ~/tick:
        function ~/{region}/tick

function ~/remove_speaker:
    kill @n[tag=nbs_speaker,distance=..1]
    kill @n[tag=nbs_loudspeaker,distance=..1]