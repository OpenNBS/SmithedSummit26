import glob
import logging

from src.config import SPEAKER_RANGES

from ./const import REGIONS, PLAYBACK, TEMP, SONG_MANIFEST, SONG_INDICES
from ./advancements import generate_song_advancement


logger = logging.getLogger(__name__)

logger.info("Generating playback functions")


#> setup

append function ~/load:
    merge function_tag minecraft:load {"values": [(~/)]}

    scoreboard objectives add nbs dummy
    scoreboard players set shuffle nbs 0

    # load manifest
    for song in SONG_MANIFEST:
        region = song["region"]

        if region is not None:
            index = SONG_INDICES.setdefault(region, 0)
            SONG_INDICES[region] += 1

            entry = {
                "name": song["id"],
                "index": index,
                "formatted_string": f'{song["title"]} - {song["author"]}',
                "title": song["title"],
                "author": song["author"],
            }

            data modify storage PLAYBACK[region] f"songs.{region}" append value entry
            generate_song_advancement(region, song["id"], song["title"], song["author"])
        
    for region in REGIONS:
        # just in case
        execute unless data storage TEMP[region] input run data modify storage TEMP[region] input set value {}
        
        # do we want to change song on reload?
        function ~/../{region}/change_song

    function #nbs:playback/play


append function ~/tick:
    merge function_tag minecraft:tick {"values": [(~/)]}
    
    # handles tick TBD: threading
    for region in REGIONS:
        if score f"{region}.playing" nbs matches 1.. function ~/../{region}/tick


for region in REGIONS:
    #> Main regional namespace
    function ~/{region}:

        #> Region tick
        function ~/tick:
            # grab playback info
            if score f"{region}.playing" nbs matches 1 run scoreboard players add f"{region}.songtime" nbs 1
            store result storage PLAYBACK[region] f"playing.{region}.tick" int 1 run scoreboard players get f"{region}.songtime" nbs
            
            # copy for input for macro
            data modify storage TEMP[region] input set from storage PLAYBACK[region] f"playing.{region}"
            
            # all regional speakers anim. w/ the same randomness
            store result storage TEMP[region] input.random int 1 run random value 1..6

            as @e[type=item_display,tag=f"nbs.speaker.{region}"] at @s function ~/speaker with storage TEMP[region] input:
                # This handles our main song tick.
                #  First, we run our tick for our current region song, this should return true if there was a player who heard it.
                #    The `/root` will choose the specific short/med/long (which returns val up the stack for us)
                #  Then, if we pass, we can detect if we need to play a beat.
                #  If we do, then we play a random beet provisoned earlier
                raw f"$execute if function nbs:song/$(name)/$(tick)/root if entity @s[tag=nbs.beat] run function summit_ambiance:speaker_{region}/animations/beat_$(random)/play"
                
                tag @s remove nbs.beat
            
        # Changing the song fixes out PLAYBACK storage
        # We reset our tick songtime counter
        # Then we grab the index of our song
        # Lastly, we grab and set our song from our storage and set it to the right spot
        #  sharing the new song w/ the current listeners
        function ~/change_song:
            scoreboard players set f"{region}.songtime" nbs -1
            store result storage PLAYBACK[region] f"playing.{region}.index" int 1 run scoreboard players get f"{region}.songindex" nbs
            
            # actually do da macro (and set our title ;)
            with storage PLAYBACK[region] f"playing.{region}":
                raw f"$data modify storage {PLAYBACK[region]} playing.{region} set from storage {PLAYBACK[region]} songs.{region}[$(index)]"
                function ~/../title with storage PLAYBACK[region] f"playing.{region}"


        #> Effects
        # display AJ text
        function ~/title:
            raw f'$execute \
                as @e[type=item_display,tag=nbs.speaker.{region}] \
                on passengers \
                if entity @s[tag=aj.global.node.text_display] \
                run data modify entity @s text.text set value "🎵 $(formatted_string)"'

        # display actionbar to nearby players (a bit laggy but very rare)
        for speaker in SPEAKER_RANGES:
            variant = speaker["name"]
            range = speaker["outer_range"]

            append function ~/../title:
                raw f'$execute at @e[type=item_display,tag=nbs.speaker.{region},tag=nbs.speaker.{variant}] run title @a[distance=..{range}] actionbar [{{"text":"🎵 Now Playing: ","color":"green"}},{{"text":"$(formatted_string)","color":"white"}}]'


        #> Song Controls

        song_count = REGIONS[region].song_count

        # we use function tags for easy search
        function ~/next:
            merge function_tag (~/) {"values": [(~/)]}
            scoreboard players add f"{region}.songindex" nbs 1
            if score f"{region}.songindex" nbs matches f"{song_count}.." run scoreboard players set f"{region}.songindex" nbs 0
            function ~/../change_song

        function ~/prev:
            merge function_tag (~/) {"values": [(~/)]}
            scoreboard players remove f"{region}.songindex" nbs 1
            if score f"{region}.songindex" nbs matches ..-1 run scoreboard players set f"{region}.songindex" nbs (song_count - 1)
            function ~/../change_song

        function ~/pause:
            merge function_tag (~/../../pause) {"values": [(~/)]}
            scoreboard players set f"{region}.playing" nbs 0

        function ~/play:
            merge function_tag (~/../../play) {"values": [(~/)]}
            scoreboard players set f"{region}.playing" nbs 1

        function ~/stop:
            merge function_tag (~/../../stop) {"values": [(~/)]}
            scoreboard players set f"{region}.playing" nbs 0
            scoreboard players set f"{region}.songtime" nbs -1

        function ~/shuffle:
            merge function_tag (~/) {"values": [(~/)]}

            scoreboard players operation f"{region}.prevsong" nbs = sf"{region}.songindex" nbs
            store result score f"{region}.songindex" nbs run random value (0, song_count - 1)
            if score f"{region}.songindex" nbs = f"{region}.prevsong" nbs run function ~/../next
            function ~/../change_song

        function ~/advance:
            merge function_tag (~/) {"values": [(~/)]}
            if score shuffle nbs matches 0 run function ~/../next
            if score shuffle nbs matches 1 run function ~/../shuffle
