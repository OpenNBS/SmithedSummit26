from typing import Any, NotRequired, TypedDict

from beet import Context, LootTable
from src.utilities import resource
from src.utilities.resource import Resource, TranslationType, NAMESPACE

Components = dict[str, Any]


class Description(TypedDict):
    lore: Components
    tagline: Components
    tooltip: Components


class Extra(TypedDict, total=False):
    description: NotRequired[Description]


OPENNBS_TOOLTIP = {
    "translate": "nbs.tooltip",
    "font": "nbs:tooltip",
    "color": "#ec8c0c",
    "italic": False,
}


def give_item(loot_resource: Resource, max_count: int | None = None) -> None:
    if max_count is not None:
        custom_data: Components = {}

        custom_data[NAMESPACE] = {
            "type": loot_resource.path()
        }

        function summit.items:api/count_items {"custom_data": str(custom_data), "max": max_count}

        execute if score $below_max summit.temp matches 0 return fail

    swing @s

    loot give @s loot loot_resource.value


def create_loot(asset_resource: Resource, components: Components) -> None:
    if "minecraft:custom_data" not in components:
        components["minecraft:custom_data"] = {}

    if NAMESPACE not in components["minecraft:custom_data"]:
        components["minecraft:custom_data"][NAMESPACE] = {}

    components["minecraft:custom_data"][NAMESPACE]["type"] = asset_resource.path()

    ctx.data.loot_tables[asset_resource.value] = LootTable(
        {
            "pools": [
                {
                    "rolls": 1,
                    "entries": [
                        {
                            "type": "minecraft:item",
                            "name": "minecraft:note_block",
                            "functions": [
                                {
                                    "function": "minecraft:set_components",
                                    "components": components,
                                }
                            ],
                        }
                    ],
                }
            ]
        }
    )


def create_persistent_item(
    asset_id: str, item_model_component: str, extra: Extra = {}
) -> Resource:
    translation_resource = resource.get_translation(TranslationType.ITEM, asset_id)

    lore_translation_resource = translation_resource.append("lore")
    tagline_translation_resource = translation_resource.append("tagline")

    rarity_component = "rare"
    max_stack_size_component = 1

    item_name_component = {"translate": translation_resource.value}

    custom_data_component = {
        "summit": {
            "persist": {}
        }
    }

    if "minecraft:custom_data" in extra:
        custom_data_component = {
            **custom_data_component,
            **extra["minecraft:custom_data"],
        }

        del extra["minecraft:custom_data"]

    description: Description = {
        "lore": {
            "translate": lore_translation_resource.value,
            "color": "#20CFF0",
            "italic": False,
        },
        "tagline": {
            "translate": tagline_translation_resource.value,
            "color": "dark_gray",
            "italic": True,
        },
        "tooltip": {},
    }

    # Absolutely cursed way to modify item lore
    # Needs refactor
    lore_component: list[Any] = []

    if "description" in extra:
        description = {**description, **extra["description"]}

        if "tooltip" in extra["description"]:
            lore_component.extend([extra["description"]["tooltip"]])

        del extra["description"]

    description_order = [
        description["lore"],
        description["tagline"],
        "",
        OPENNBS_TOOLTIP,
    ]

    description_order.reverse()

    lore_component.extend(description_order)

    lore_component.reverse()

    components = {
        "minecraft:item_name": item_name_component,
        "minecraft:item_model": item_model_component,
        "minecraft:lore": lore_component,
        "minecraft:rarity": rarity_component,
        "minecraft:max_stack_size": max_stack_size_component,
        "minecraft:custom_data": custom_data_component,
        **extra,
    }

    loot_resource = resource.get_asset(asset_id)

    create_loot(loot_resource, components)

    return loot_resource
