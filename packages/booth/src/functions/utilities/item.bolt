import json
from typing import Any, NotRequired, TypedDict
from src.utilities import resource
from src.utilities.resource import TranslationType


class Description(TypedDict):
    lore: Any
    tagline: Any
    tooltip: Any

class Extra(TypedDict, total=False):
    description: NotRequired[Description]


OPENNBS_TOOLTIP = {
    "translate": f"nbs.tooltip",
    "font": "nbs:tooltip",
    "color": "#ec8c0c",
    "italic": False
}


def give_item(item: str) -> None:
    swing @s

    if items entity @s weapon.mainhand *:
        give @s item
    unless items entity @s weapon.mainhand *:
        item replace entity @s weapon.mainhand with item

def dump_component(component: dict[str, Any]) -> str:
    parts: list[str] = []

    for key, value in component.items():
        parts.append(f"{key}={json.dumps(value)}")

    return ", ".join(parts)

def give_persistent_item(asset_resource_id: str, item_model_component: str, extra: Extra = {}) -> None:
    translation_resource = resource.get_translation(TranslationType.ITEM, asset_resource_id)

    lore_translation_resource = translation_resource.append("lore")
    tagline_translation_resource = translation_resource.append("tagline")

    rarity_component = "rare"
    max_stack_size_component = 1

    item_name_component = {
        "translate": translation_resource.value
    }

    custom_data_component = {
        "summit": {
            "persist": {}
        }
    }

    if "minecraft:custom_data" in extra:
        custom_data_component = {
            **custom_data_component,
            **extra["minecraft:custom_data"]
        }

        del extra["minecraft:custom_data"]

    description: Description = {
        "lore": {
            "translate": lore_translation_resource.value,
            "color": "#20CFF0",
            "italic": False
        },
        "tagline": {
            "translate": tagline_translation_resource.value,
            "color": "dark_gray",
            "italic": True
        }
    }

    # Absolutely cursed way to modify item lore
    # Needs refactor
    lore_component: list[Any] = []

    if "description" in extra:
        description = {
            **description,
            **extra["description"]
        }

        if "tooltip" in extra["description"]:
            lore_component.extend([
                extra["description"]["tooltip"]
            ])

        del extra["description"]

    description_order = [
        description["lore"],
        description["tagline"],
        "",
        OPENNBS_TOOLTIP
    ]

    description_order.reverse()

    lore_component.extend(description_order)

    lore_component.reverse()

    components: dict[str, Any] = {
        "minecraft:item_name": item_name_component,
        "minecraft:item_model": item_model_component,
        "minecraft:lore": lore_component,
        "minecraft:rarity": rarity_component,
        "minecraft:max_stack_size": max_stack_size_component,
        "minecraft:custom_data": custom_data_component,
        **extra
    }

    components_dumped = dump_component(components)

    give_item(f"minecraft:note_block[{components_dumped}]")
