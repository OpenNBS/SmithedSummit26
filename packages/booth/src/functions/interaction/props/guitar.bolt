from typing import TypedDict


guitar_position = (-190.5, 87.0, 55.5)
selector = @a[tag=summit.in_booth.nbs,distance=..12]

class Note(TypedDict):
    key: float
    particle: float

note_e_1: Note = {
    # TODO: out-of-range note
    "key": 0.891,
    "particle": 0
}

note_a_1: Note = {
    "key": 0.595,
    "particle": 0.125
}

note_d_1: Note = {
    "key": 0.794,
    "particle": 0.333
}

note_g_2: Note = {
    "key": 1.059,
    "particle": 0.542
}

note_b_2: Note = {
    "key": 1.335,
    "particle": 0.708
}

note_e_2: Note = {
    "key": 1.782,
    "particle": 0.917
}

def play_note(note: Note) -> None:
    playsound minecraft:block.note_block.guitar block selector ~ ~ ~ 1 note["key"]
    particle minecraft:note ~ ~0.75 ~ note["particle"] 0 0 1 0 normal selector

function ~/root:
    swing @s

    execute store result storage nbs:main guitar.key int 1 run random value 1..6

    positioned guitar_position run function ~/../play with storage nbs:main guitar

function ~/play:
    $function nbs:interaction/props/guitar/note/$(key)

function ~/note/1:
    play_note(note_e_1)

function ~/note/2:
    play_note(note_a_1)

function ~/note/3:
    play_note(note_d_1)

function ~/note/4:
    play_note(note_g_2)

function ~/note/5:
    play_note(note_b_2)

function ~/note/6:
    play_note(note_e_2)

function ~/hit:
    positioned guitar_position:
        function ~/../note/1
        function ~/../note/2
        function ~/../note/3
        function ~/../note/4
        function ~/../note/5
