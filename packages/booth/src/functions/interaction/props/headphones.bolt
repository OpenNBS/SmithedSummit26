from src.utilities import resource

from ../../utilities/item import give_persistent_item

asset_resource_id = "headphones"

equippable_component = {
    "slot": "head"
}

function ~/root:
    item_model_component = resource.get_asset(f"props/{asset_resource_id}")

    give_persistent_item(asset_resource_id, item_model_component.value, {"minecraft:equippable": equippable_component})
