microwave_position = (-194.5, 65.5, 54.5)
selector = @a[tag=summit.in_booth.nbs,distance=..8]

merge function_tag minecraft:load {
    "values": [(~/load)]
}

append function ~/load:
    scoreboard objectives add nbs.props dummy

    scoreboard players set microwave_active nbs.props 0

function ~/root:
    if score microwave_active nbs.props matches 0 if items entity @s weapon.mainhand minecraft:note_block[minecraft:custom_data~{"microwavable": True}]:
        swing @s

        scoreboard players set microwave_active nbs.props 1

        item modify entity @s weapon.mainhand nbs:remove_one
        function ~/../play

function ~/play:
    function ~/../step/1
    schedule function ~/../step/2 8t
    schedule function ~/../step/3 12t
    schedule function ~/../step/4 16t
    schedule function ~/../step/5 48t


function ~/step/1:
    positioned microwave_position:
        playsound minecraft:block.decorated_pot.insert block selector ~ ~ ~ 1 1.6

function ~/step/2:
    positioned microwave_position:
        playsound minecraft:block.decorated_pot.insert block selector ~ ~ ~ 1 1.82

function ~/step/3:
    positioned microwave_position:
        playsound minecraft:block.decorated_pot.insert block selector ~ ~ ~ 1 1.95

function ~/step/4:
    positioned microwave_position:
        # TODO: out-of-range note
        playsound minecraft:block.note_block.bit block selector ~ ~ ~ 0.3 0
        playsound minecraft:block.brewing_stand.brew block selector ~ ~ ~ 0.05 0.07

function ~/step/5:
    positioned microwave_position:
        playsound minecraft:block.mud.break block selector ~ ~ ~ 0.8 0.12
        playsound minecraft:block.mud.break block selector ~ ~ ~ 1 0.35

        playsound minecraft:entity.sulfur_cube.squish block selector -195 65.5 54 0.3 0.35

        playsound minecraft:entity.firework_rocket.large_blast block selector -195 65.5 54 0.35 1.5

        particle minecraft:campfire_cosy_smoke ~0.1 ~0.1 ~0.3 0 0.02 0 1 0 normal selector

        scoreboard players set microwave_active nbs.props 0
