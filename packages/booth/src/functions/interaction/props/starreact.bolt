                                    {"color": "#FFFF71", "text": "r"},
                                    {"color": "#FFFF81", "text": "r"},
                                    {"color": "#FFFF90", "text": "e"},
                                    {"color": "#FFFF9F", "text": "a"},
                                    {"color": "#FFFFAE", "text": "c"},
                                    {"color": "#FFFFBD", "text": "t"},
                                ],
                                "text": "",
                            }
                        ],
                        "text": "",
                    },
                    '"',
