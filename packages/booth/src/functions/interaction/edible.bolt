from enum import Enum
from typing import TypedDict

from src.utilities import resource
from src.utilities.resource import Resource

from ../../utilities/item import create_loot, give_item, Components


class EdibleType(Enum):
    FOOD = 1
    DRINK = 2


class EdibleComponents(TypedDict):
    consumable: dict
    max_stack_size: int


class Project(Enum):
    NBS = 1
    CNK = 2
    FOODSTUFFS = 3


SHARED_FOOD_COMPONENT = {"nutrition": 0, "saturation": 0, "can_always_eat": True}

SHARED_CUSTOM_DATA_COMPONENT = {"microwavable": True}

PROJECT_TOOLTIP_COMPONENTS: dict[Project, dict] = {
    Project.CNK: {
        "translate": "cnk.tooltip",
        "font": "cnk:tooltip",
        "color": "white",
        "italic": False,
    },
    Project.FOODSTUFFS: {
        "translate": "foodstuffs.tooltip",
        "fallback": "Foodstuffs",
        "color": "blue",
        "italic": False,
    },
}

EDIBLE_COMPONENTS: dict[EdibleType, EdibleComponents] = {
    EdibleType.FOOD: {"consumable": {}, "max_stack_size": 64},
    EdibleType.DRINK: {
        "consumable": {"animation": "drink", "sound": "entity.generic.drink"},
        "max_stack_size": 16,
    },
}

EDIBLE_IDS = [
    "pink_donut",
    "cinnamon_roll",
    "pizza",
    "cake_slice",
    "pumpkin_latte"
]

def create_edible_item(
    namespace: str,
    path: str,
    edible_type: EdibleType,
    translation_component: Components = {}
) -> Resource:
    item_model_component = f"{namespace}:{path}"
    edible_component = EDIBLE_COMPONENTS[edible_type]
    lore_component = [PROJECT_TOOLTIP_COMPONENTS[Project[namespace.upper()]]]

    translation_component = {
        "translate": f"item.{namespace}.{path}",
        **translation_component,
    }

    components: Components = {
        "minecraft:food": dict(SHARED_FOOD_COMPONENT),
        "minecraft:consumable": edible_component['consumable'],
        "minecraft:max_stack_size": edible_component['max_stack_size'],
        "minecraft:item_model": item_model_component,
        "minecraft:item_name": translation_component,
        "minecraft:lore": lore_component,
        "minecraft:custom_data": dict(SHARED_CUSTOM_DATA_COMPONENT)
    }

    loot_resource = resource.get_asset("edible", path)

    create_loot(loot_resource, components)

    return loot_resource

def give_edible_item(path: str, loot_resource: Resource, max_count: int | None = None) -> None:
    give_item(loot_resource, max_count)

    scoreboard players add @s f"nbs.edibles.obtained_{path}" 1

    function ~/../refresh_sticker_progress


merge function_tag minecraft:load {
    "values": [(~/load)]
}

append function ~/load:
    for edible_id in EDIBLE_IDS:
        scoreboard objectives add f"nbs.edibles.obtained_{edible_id}" dummy

    scoreboard objectives add nbs.edibles.obtained_all dummy

function ~/refresh_sticker_progress:
    unless score @s nbs.edibles.obtained_all matches 1:
        # I tried to make this better, but without knowing how to return early, we get this instead
        if score @s nbs.edibles.obtained_pink_donut matches 1.. if score @s nbs.edibles.obtained_cinnamon_roll matches 1.. if score @s nbs.edibles.obtained_pizza matches 1.. if score @s nbs.edibles.obtained_cake_slice matches 1.. if score @s nbs.edibles.obtained_pumpkin_latte matches 1..:
            scoreboard players set @s nbs.edibles.obtained_all 1

            function nbs:stickers/collected_all_foods

function ~/pink_donut:
    path = "pink_donut"

    loot_resource = create_edible_item("cnk", path, EdibleType.FOOD)

    give_edible_item(path, loot_resource, 5)

function ~/cinnamon_roll:
    path = "cinnamon_roll"

    loot_resource = create_edible_item("cnk", path, EdibleType.FOOD)

    give_edible_item(path, loot_resource, 5)

function ~/pizza:
    path = "pizza"

    loot_resource = create_edible_item("cnk", path, EdibleType.FOOD)

    give_edible_item(path, loot_resource, 5)

function ~/cake_slice:
    path = "cake_slice"

    loot_resource = create_edible_item("foodstuffs", path, EdibleType.FOOD, translation_component={
        "fallback": "Cake Slice"
    })

    give_edible_item(path, loot_resource, 5)

function ~/pumpkin_latte:
    path = "pumpkin_latte"

    loot_resource = create_edible_item("cnk", path, EdibleType.DRINK)

    give_edible_item(path, loot_resource, 5)
